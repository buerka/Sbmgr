[Unit]
Description=Independent DataImpulse sticky SOCKS5 gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/dataimpulse-gateway/gateway.py --config /srv/dataimpulse-gateway/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dataimpulse-gateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=4096
MemoryMax=256M

[Install]
WantedBy=multi-user.target
