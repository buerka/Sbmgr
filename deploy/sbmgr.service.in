[Unit]
Description=sbmgr sing-box user manager
After=network-online.target sing-box.service
Wants=network-online.target
Wants=sing-box.service

[Service]
Type=simple
Environment=SBMGR_HOME=@SBMGR_HOME@
WorkingDirectory=@SBMGR_HOME@
ExecStart=@SBMGR_HOME@/sbmgr daemon
Restart=always
RestartSec=5s
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@SBMGR_HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_KILL

[Install]
WantedBy=multi-user.target
